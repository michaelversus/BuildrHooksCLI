{
  "hooks": {
    "BeforeToolCall": [
      {
        "hooks": [
          {
            "command": "buildrhooks codex tool-start",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": null
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "buildrhooks codex session-start",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": null
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "buildrhooks codex stop",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": null
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/share/myskills/runner/bin/python \"$HOME\"/GitHub/MySkills/afk/codex/native_runtime.py hook --index \"$HOME\"/GitHub/BuildrHooksCLI/.git/afk-native-active.json",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "buildrhooks codex prompt-submit",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": null
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/share/myskills/runner/bin/python \"$HOME\"/GitHub/MySkills/afk/codex/native_runtime.py hook --index \"$HOME\"/GitHub/BuildrHooksCLI/.git/afk-native-active.json",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/share/myskills/runner/bin/python \"$HOME\"/GitHub/MySkills/afk/codex/native_runtime.py hook --index \"$HOME\"/GitHub/BuildrHooksCLI/.git/afk-native-active.json",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.local/share/myskills/runner/bin/python \"$HOME\"/GitHub/MySkills/afk/codex/native_runtime.py hook --index \"$HOME\"/GitHub/BuildrHooksCLI/.git/afk-native-active.json",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
