{
  "schemaVersion": 1,
  "runtimeVersion": 1,
  "packagePath": ".",
  "build": {
    "configuration": "debug",
    "scratchPath": ".build",
    "arguments": [
      "--disable-sandbox"
    ]
  },
  "staging": {
    "configuration": "release"
  },
  "defaultProduct": "BuildrHooksCLI",
  "products": {
    "BuildrHooksCLI": {
      "executable": "buildrhooks",
      "resources": [
        "BuildrHooksCLI_BuildrHooksCLI.bundle",
        "BuildrHooksCLI_BuildrBridgeContracts.bundle"
      ],
      "smoke": [
        {
          "arguments": [
            "--version"
          ],
          "timeout": 10
        },
        {
          "arguments": [
            "--help"
          ],
          "stdoutContains": "Relay hook events",
          "timeout": 10
        },
        {
          "arguments": [
            "claude",
            "mod",
            "setup",
            "--directory",
            "smoke-mod",
            "--apply"
          ],
          "stdoutContains": "Prepared.",
          "timeout": 10
        },
        {
          "arguments": [
            "report",
            "--help"
          ],
          "stdoutContains": "discover",
          "timeout": 10
        },
        {
          "arguments": [
            "tracking",
            "record-rewrite",
            "--help"
          ],
          "stdoutContains": "--execution",
          "timeout": 10
        },
        {
          "arguments": [
            "capabilities",
            "--json",
            "--protocol-version",
            "1",
            "--operation",
            "recordRewrite"
          ],
          "stdoutContains": "ready",
          "timeout": 10
        }
      ]
    }
  },
  "tests": {
    "parallel": false,
    "coverage": true
  },
  "quality": {
    "tools": [
      "swiftformat",
      "swiftlint"
    ],
    "paths": [
      "Package.swift",
      "Sources",
      "Tests"
    ]
  },
  "timeout": 600
}
